# ---- Public (safe in the browser) ----
# Full site URL, used for SEO metadata and meeting links sent on WhatsApp
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Your Calendly event link, e.g. https://calendly.com/your-account/style-consultation
NEXT_PUBLIC_CALENDLY_URL=
# WhatsApp contact number for the "Chat with us" button — digits with country code, e.g. 9198XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Jitsi server. meet.jit.si is for development only (see README)
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
# Optional room prefix, e.g. your JaaS app ID (vpaas-magic-cookie-...)
NEXT_PUBLIC_JITSI_ROOM_PREFIX=

# ---- Server-only secrets (never prefix with NEXT_PUBLIC_) ----
# Signing key you chose when creating the Calendly webhook subscription
CALENDLY_WEBHOOK_SIGNING_KEY=
# Long random string used to derive private meeting room names: openssl rand -hex 32
MEETING_ROOM_SECRET=
# WhatsApp Business Platform (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with body params {{1}} name, {{2}} date & time, {{3}} meeting link
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0
# Optional: also send each meeting link to the consultant
CONSULTANT_WHATSAPP_NUMBER=
WHATSAPP_CONSULTANT_TEMPLATE_NAME=
