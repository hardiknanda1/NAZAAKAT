# ---- Public (safe in the browser) ----
# Full site URL, used for SEO metadata and meeting links sent on WhatsApp
NEXT_PUBLIC_SITE_URL=https://www.example.com
# WhatsApp contact number for the "Chat with us" button — digits with country code, e.g. 9198XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Home page hero. Leave blank for the body-shape wheel; set to "classic" for the original photo hero.
NEXT_PUBLIC_HERO=

# ---- Server-only secrets (never prefix with NEXT_PUBLIC_) ----
# Password for the private /admin pages (bookings, availability, a booking's consultant info)
ADMIN_PASSWORD=
# Long random string used to sign meeting links: openssl rand -hex 32
MEETING_ROOM_SECRET=

# ---- Video calls: Jitsi as a Service (8x8 JaaS) — recommended ----
# App ID from the JaaS console (starts with vpaas-magic-cookie-)
JAAS_APP_ID=
# Key ID from JaaS console → API keys
JAAS_KEY_ID=
# Contents of the downloaded private key file, including the BEGIN/END lines
JAAS_PRIVATE_KEY=
# Without JaaS, calls use this Jitsi server (meet.jit.si is for testing only)
JITSI_DOMAIN=meet.jit.si

# ---- Booking, questionnaire, photos and catalogues (Supabase) ----
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Secret key (Project Settings -> API Keys -> secret key, sb_secret_...). Server-only; never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---- Body-shape analyser (/body-shape) and the discount for guessing right ----
# Gemini API key from aistudio.google.com -> Get API key. Reads the shape from the visitor's photo.
# Turn on billing for its Google project, so Google doesn't use the photos to improve its products.
GEMINI_API_KEY=
# Optional: a different Gemini model (default gemini-3.8-flash), e.g. if Google retires it
GEMINI_MODEL=
# Optional: percent off for a right guess (default 20). Public, so the page shows the same number.
NEXT_PUBLIC_SHAPE_DISCOUNT_PERCENT=

# ---- Email notification when a booking comes in (Resend) — optional ----
# API key from resend.com -> API Keys. Leave blank to skip emailing yourself on new bookings.
RESEND_API_KEY=
# Where the "new booking" email goes, e.g. you@example.com
NOTIFY_EMAIL=
# Optional: a verified Resend domain's address to send from. Without this, the sandbox sender can
# only deliver to the email the Resend account itself was created with.
NOTIFY_FROM_EMAIL=
